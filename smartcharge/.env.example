DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_LAN_MODE=true
DJANGO_EXTRA_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
SEPAY_API_TOKEN=
DEVICE_STALE_SECONDS=30
MQTT_BROKER=broker.emqx.io
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_FILE=
MQTT_PUBLIC_TEST_MODE=true
# Required in public mode. Use the exact SC_TEST_<16 lowercase hex digits> alias.
MQTT_PUBLIC_TEST_DEVICE=
MQTT_PUBLIC_TEST_LOGICAL_DEVICE=ESP32_001
MQTT_DEVICE_ID=ESP32_001
# Private MQTT mode only. Configure distinct SePay webhook credentials.
SEPAY_WEBHOOK_API_KEY=
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK=
