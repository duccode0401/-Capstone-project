# put here your custom config value
menu "SmartCharge"
config HEADLESS_TEST_MODE
    bool "HEADLESS_TEST_MODE (public bench only)"
    default n
    help
        Run Wi-Fi and diagnostics without LCD, ADC or charging hardware.
config ESP_WIFI_SSID
    string "WiFi SSID"
    default ""
    help
	SSID (network name) for the example to connect to.

config ESP_WIFI_PASSWORD
    string "WiFi Password"
    default ""
    help
	WiFi password (WPA or WPA2) for the example to use.
endmenu
