# put here your custom config value
menu "SmartCharge"
config HEADLESS_TEST_MODE
    bool "HEADLESS_TEST_MODE (public bench only)"
    default n
    help
        Run Wi-Fi and diagnostics without LCD, ADC or charging hardware.
config SC_SETUP_TIMEOUT_MINUTES
    int "Wi-Fi Setup Mode timeout (minutes)"
    range 3 30
    default 10

config SC_WIFI_FAILURES_BEFORE_SETUP
    int "Failed station connections before Setup Mode"
    range 3 20
    default 6
endmenu
